# 기본값: 아무 설정 없이 SQLite(qr-place.db)로 데모가 돈다. 이 파일을 복사하지 않아도 됨.

# ── 드라이버 강제 지정 (선택) ─────────────────────────────
# DB_DRIVER=sqlite            # 명시적으로 SQLite
# DB_DRIVER=postgres          # POSTGRES_URL 과 함께 Postgres 사용
# SQLITE_PATH=./qr-place.db   # SQLite 파일 경로 변경

# ── Postgres 로 전환할 때만 ───────────────────────────────
# POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME"
# POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/DBNAME"

# ── 카카오맵 (내 맛집 지도, /stores/map) ─────────────────────
# NEXT_PUBLIC_KAKAO_MAP_KEY=   # 카카오 개발자 콘솔 앱의 "JavaScript 키" (지도 SDK용).
#   KAKAO_REST_API_KEY(장소 검색용 REST 키)와는 다른 키이니 혼동 주의.
#   이 키를 쓰는 도메인(예: http://localhost:3000, 배포된 Vercel 도메인)을
#   카카오 개발자 콘솔 > 플랫폼 > Web 에 "JS SDK 도메인"으로 등록해야
#   지도가 뜬다 — 미등록 시 도메인 거부 에러로 로딩 실패.
#   NEXT_PUBLIC_* 값은 Next.js 빌드 타임에 번들로 굳어지므로, Vercel에서는
#   빌드 실행 전에 이 값이 설정돼 있어야 함(런타임에만 넣으면 반영 안 됨).

# ── 카카오 로그인 (점주 대시보드, 손님 개인화·룰렛) ─────────────
# AUTH_SECRET=                 # 세션 암호화 키. `npx auth secret` 으로 생성
# KAKAO_CLIENT_ID=             # 카카오 개발자 콘솔 앱의 "REST API 키"
# KAKAO_CLIENT_SECRET=         # 카카오 로그인 > 보안 > Client Secret
#   콘솔의 Redirect URI 에 http://localhost:3000/api/auth/callback/kakao 등록 필요

# ── 카카오 로컬 장소 검색 (매장 등록) ──────────────────────
# KAKAO_REST_API_KEY=          # 카카오 개발자 콘솔 앱의 "REST API 키"

# ── 메뉴 사진 업로드 (Vercel Blob) ─────────────────────────
# BLOB_READ_WRITE_TOKEN=       # Vercel 대시보드 > Storage 에서 Blob 스토어 생성 후 발급
